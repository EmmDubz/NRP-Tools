# Copy this file to .env and fill in values. Never commit .env.

# Required: Discord bot token from the Developer Portal
DISCORD_TOKEN=your_bot_token_here

# Optional HTTP API (same process as the bot). If API_PORT is unset or 0, the API is disabled.
# Pick a free port on your machine. Avoid ports already used by other services (e.g. 80, 443, 8080).
API_HOST=127.0.0.1
API_PORT=0

# Required for GET/POST/DELETE /api/reminders (Bearer token). Not needed for public GET /api/rp-time.
API_SECRET=
